syntax = "v1"

info (
    title:   "Booking Service"
    desc:    "问玄东方 预约服务 - 创建/列表/详情/状态流转/评价/管理台"
    author:  "askxuan"
    version: "v1"
)

// ============ 预约基础 ============
type (
    Booking {
        Id            string  `json:"id"`            // 预约单号 B20260630001
        UserId        string  `json:"userId"`        // 用户ID
        TempleId      string  `json:"templeId"`      // 寺院编码 T001
        TempleName    string  `json:"templeName"`    // 寺院名称
        MasterId      string  `json:"masterId"`      // 法师编码 M001
        MasterName    string  `json:"masterName"`    // 法师名称
        ServiceId     string  `json:"serviceId"`     // 服务编码 S001
        ServiceName   string  `json:"serviceName"`   // 服务名称
        BookingDate   string  `json:"bookingDate"`   // 预约日期 yyyy-MM-dd
        SlotCode      string  `json:"slotCode"`
        TimeSlot      string  `json:"timeSlot"`      // 时段 09:00-10:00
        ServiceFee    float64 `json:"serviceFee"`
        MeritMoney    float64 `json:"meritMoney"`    // 功德金
        MeritMoneyTier string `json:"meritMoneyTier"` // 功德金档位
        TotalFee      float64 `json:"totalFee"`
        PaymentNo     string  `json:"paymentNo"`
        PaymentStatus string  `json:"paymentStatus"`
        Status        string  `json:"status"`        // pending/confirmed/in_progress/completed/cancelled/reviewed
        Note          string  `json:"note"`          // 备注
        CreatedAt     string  `json:"createdAt"`     // 创建时间
    }

    CreateReq {
        RequestId      string  `json:"requestId,optional"`
        UserId         string  `json:"userId"`
        TempleId       string  `json:"templeId"`
        TempleName     string  `json:"templeName,optional"`
        MasterId       string  `json:"masterId"`
        MasterName     string  `json:"masterName,optional"`
        ServiceId      string  `json:"serviceId"`
        ServiceName    string  `json:"serviceName,optional"`
        BookingDate    string  `json:"bookingDate"`
        SlotCode       string  `json:"slotCode,optional"`
        TimeSlot       string  `json:"timeSlot,optional"`
        MeritMoney     float64 `json:"meritMoney"`
        MeritMoneyTier string  `json:"meritMoneyTier"`
        Note           string  `json:"note,optional"`
    }

    CreateResp {
        Id            string  `json:"id"`
        Status        string  `json:"status"`
        PaymentStatus string  `json:"paymentStatus"`
        PaymentNo     string  `json:"paymentNo"`
        ServiceFee    float64 `json:"serviceFee"`
        MeritMoney    float64 `json:"meritMoney"`
        TotalFee      float64 `json:"totalFee"`
        Simulated     bool    `json:"simulated"`
    }

    AvailabilityReq {
        TempleId   string `form:"templeId"`
        ServiceId  string `form:"serviceId"`
        BookingDate string `form:"date"`
    }

    AvailableSlot {
        SlotCode string `json:"slotCode"`
        Label string `json:"label"`
        TimeRange string `json:"timeRange"`
        Capacity int `json:"capacity"`
        Remaining int `json:"remaining"`
        Available bool `json:"available"`
    }

    AvailabilityResp {
        TempleId string `json:"templeId"`
        ServiceId string `json:"serviceId"`
        ServiceName string `json:"serviceName"`
        BookingDate string `json:"bookingDate"`
        ServiceFee float64 `json:"serviceFee"`
        Slots []AvailableSlot `json:"slots"`
    }

    PayReq { Id string `path:"id"` }

    ChatListReq {
        Page int `form:"page,default=1"`
        Size int `form:"size,default=20"`
    }

    ChatConversation {
        ConversationId string `json:"conversationId"`
        SourceType string `json:"sourceType"`
        SourceId string `json:"sourceId"`
        BookingId string `json:"bookingId"`
        PeerId string `json:"peerId"`
        PeerOpenIMId string `json:"peerOpenIMId"`
        PeerName string `json:"peerName"`
        PeerAvatar string `json:"peerAvatar"`
        TempleName string `json:"templeName"`
        ServiceName string `json:"serviceName"`
        BookingDate string `json:"bookingDate"`
        ExpiresAt string `json:"expiresAt"`
        LastMessage string `json:"lastMessage"`
        LastMessageAt string `json:"lastMessageAt"`
        CanChat bool `json:"canChat"`
    }

    ChatListResp {
        Total int64 `json:"total"`
        List []ChatConversation `json:"list"`
        Page int `json:"page"`
        Size int `json:"size"`
    }

    ChatMessageListReq {
        Id string `path:"id"`
        Page int `form:"page,default=1"`
        Size int `form:"size,default=50"`
    }

    ChatMessage {
        Id int64 `json:"id"`
        ConversationId string `json:"conversationId"`
        SourceType string `json:"sourceType"`
        BookingId string `json:"bookingId"`
        ClientMessageId string `json:"clientMessageId"`
        SenderType string `json:"senderType"`
        SenderId string `json:"senderId"`
        ReceiverId string `json:"receiverId"`
        Content string `json:"content"`
        Status string `json:"status"`
        CreateTime string `json:"createTime"`
    }

    ChatMessageListResp {
        Total int64 `json:"total"`
        List []ChatMessage `json:"list"`
        Page int `json:"page"`
        Size int `json:"size"`
    }

    ChatMessageSendReq {
        Id string `path:"id"`
        ClientMessageId string `json:"clientMessageId"`
        Content string `json:"content"`
    }

    ConsultationQuoteReq { MasterId string `form:"masterId"` }
    ConsultationQuoteResp {
        MasterId string `json:"masterId"`
        MasterName string `json:"masterName"`
        TempleId string `json:"templeId"`
        TempleName string `json:"templeName"`
        Enabled bool `json:"enabled"`
        ConsultFee float64 `json:"consultFee"`
        ValidHours int `json:"validHours"`
        ResponseMinutes int `json:"responseMinutes"`
    }
    ConsultationCreateReq {
        RequestId string `json:"requestId"`
        MasterId string `json:"masterId"`
        Question string `json:"question,optional"`
    }
    Consultation {
        Id string `json:"id"`
        UserId string `json:"userId"`
        MasterId string `json:"masterId"`
        MasterName string `json:"masterName"`
        TempleId string `json:"templeId"`
        TempleName string `json:"templeName"`
        ConsultFee float64 `json:"consultFee"`
        ValidHours int `json:"validHours"`
        ResponseMinutes int `json:"responseMinutes"`
        Question string `json:"question"`
        PaymentNo string `json:"paymentNo"`
        PaymentStatus string `json:"paymentStatus"`
        Status string `json:"status"`
        ValidFrom string `json:"validFrom"`
        ExpiresAt string `json:"expiresAt"`
        Simulated bool `json:"simulated"`
        ConversationId string `json:"conversationId"`
        CreatedAt string `json:"createdAt"`
    }
    ConsultationListReq {
        Status string `form:"status,optional"`
        Page int `form:"page,default=1"`
        Size int `form:"size,default=20"`
    }
    ConsultationListResp {
        Total int64 `json:"total"`
        List []Consultation `json:"list"`
        Page int `json:"page"`
        Size int `json:"size"`
    }
    ConsultationDetailReq { Id string `path:"id"` }
    ConsultationPayReq { Id string `path:"id"` }

    ListReq {
        UserId string `form:"userId,optional"`
        Status string `form:"status,optional"`
        TempleId string `form:"templeId,optional"`
        Page   int    `form:"page,default=1"`
        Size   int    `form:"size,default=20"`
    }

    ListResp {
        Total int64     `json:"total"`
        List  []Booking `json:"list"`
        Page  int       `json:"page"`
        Size  int       `json:"size"`
    }

    DetailReq {
        Id string `path:"id"`
    }

    StatusReq {
        Id     string `path:"id"`
        Status string `json:"status"` // 目标状态
    }

    StatusResp {
        Id     string `json:"id"`
        Status string `json:"status"`
    }
)

// ============ 评价 ============
type (
    BookingReview {
        Id           int64    `json:"id"`
        BookingId    string   `json:"bookingId"`
        UserId       string   `json:"userId"`
        Rating       int      `json:"rating"`      // 1-5
        Content      string   `json:"content"`
        Images       []string `json:"images"`
        MasterReply  string   `json:"masterReply"`
        CreateTime   string   `json:"createTime"`
    }

    ReviewCreateReq {
        Id      string   `path:"id"` // 预约ID
        Rating  int      `json:"rating"`
        Content string   `json:"content"`
        Images  []string `json:"images,optional"`
    }

    ReviewCreateResp {
        ReviewId int64 `json:"reviewId"`
    }

    ReviewDetailReq {
        Id string `path:"id"` // 预约ID
    }

    ReviewReplyReq {
        Id          string `path:"id"` // 预约ID
        MasterReply string `json:"masterReply"`
    }
)

// ============ 管理台 ============
type (
    AdminBookingListReq {
        TempleId string `form:"templeId"`
        Status   string `form:"status,optional"`
        MasterId string `form:"masterId,optional"`
        Page     int    `form:"page,default=1"`
        Size     int    `form:"size,default=20"`
    }

    AdminBookingListResp {
        Total int64     `json:"total"`
        List  []Booking `json:"list"`
        Page  int       `json:"page"`
        Size  int       `json:"size"`
    }

    AdminBookingReportReq {
        TempleId string `form:"templeId"`
        StartTime string `form:"startTime,optional"`
        EndTime string `form:"endTime,optional"`
    }
    BookingTrendPoint {
        Date string `json:"date"`
        Bookings int `json:"bookings"`
        Revenue float64 `json:"revenue"`
    }
    BookingRevenueStats {
        TotalRevenue float64 `json:"totalRevenue"`
        BookingCount int `json:"bookingCount"`
        AvgBookingValue float64 `json:"avgBookingValue"`
        CompletedCount int `json:"completedCount"`
    }
    BookingServiceDist {
        ServiceName string `json:"serviceName"`
        Count int `json:"count"`
        Percentage float64 `json:"percentage"`
    }
    BookingMasterRank {
        MasterCode string `json:"masterCode"`
        MasterName string `json:"masterName"`
        BookingCount int `json:"bookingCount"`
        Revenue float64 `json:"revenue"`
    }
    AdminBookingReportResp {
        BookingTrend []BookingTrendPoint `json:"bookingTrend"`
        RevenueStats BookingRevenueStats `json:"revenueStats"`
        ServiceDistribution []BookingServiceDist `json:"serviceDistribution"`
        MasterRanking []BookingMasterRank `json:"masterRanking"`
    }

    AdminBookingActionReq {
        Id     string `path:"id"`
        Remark string `json:"remark,optional"`
    }

    StatusLogReq {
        Id string `path:"id"`
    }

    BookingStatusLog {
        Id           int64  `json:"id"`
        BookingId    string `json:"bookingId"`
        FromStatus   string `json:"fromStatus"`
        ToStatus     string `json:"toStatus"`
        OperatorId   string `json:"operatorId"`
        OperatorType string `json:"operatorType"` // user/temple_admin/system
        Remark       string `json:"remark"`
        CreateTime   string `json:"createTime"`
    }

    StatusLogResp {
        List []BookingStatusLog `json:"list"`
    }
)

// ============ C端分组（保留） ============
@server (
    group: booking
    prefix: /api/v1/bookings
)
service booking-service {
    @handler availability
    get /availability (AvailabilityReq) returns (AvailabilityResp)

    @handler create
    post / (CreateReq) returns (CreateResp)

    @handler pay
    post /:id/pay (PayReq) returns (CreateResp)

    @handler list
    get / (ListReq) returns (ListResp)

    @handler chatList
    get /chats (ChatListReq) returns (ChatListResp)

    @handler chatMessageList
    get /:id/chat/messages (ChatMessageListReq) returns (ChatMessageListResp)

    @handler chatMessageSend
    post /:id/chat/messages (ChatMessageSendReq) returns (ChatMessage)

    @handler detail
    get /:id (DetailReq) returns (Booking)

    @handler updateStatus
    put /:id/status (StatusReq) returns (StatusResp)

    @handler createReview
    post /:id/review (ReviewCreateReq) returns (ReviewCreateResp)

    @handler reviewDetail
    get /:id/review (ReviewDetailReq) returns (BookingReview)
}

@server (
    group: consultation
    prefix: /api/v1/consultations
)
service booking-service {
    @handler consultationQuote
    get /quote (ConsultationQuoteReq) returns (ConsultationQuoteResp)
    @handler consultationCreate
    post / (ConsultationCreateReq) returns (Consultation)
    @handler consultationList
    get / (ConsultationListReq) returns (ConsultationListResp)
    @handler consultationDetail
    get /:id (ConsultationDetailReq) returns (Consultation)
    @handler consultationPay
    post /:id/pay (ConsultationPayReq) returns (Consultation)
}

@server (
    group: chat
    prefix: /api/v1/chats
)
service booking-service {
    @handler chatList
    get / (ChatListReq) returns (ChatListResp)
    @handler chatMessageList
    get /:id/messages (ChatMessageListReq) returns (ChatMessageListResp)
    @handler chatMessageSend
    post /:id/messages (ChatMessageSendReq) returns (ChatMessage)
}

// ============ 寺院管理台分组 ============
@server (
    group: booking.admin
    prefix: /api/v1/admin/bookings
    jwt: Auth
)
service booking-service {
    @handler adminBookingReport
    get /report (AdminBookingReportReq) returns (AdminBookingReportResp)

    @handler adminBookingList
    get / (AdminBookingListReq) returns (AdminBookingListResp)

    @handler adminBookingDetail
    get /:id (DetailReq) returns (Booking)

    @handler adminBookingConfirm
    put /:id/confirm (AdminBookingActionReq) returns (StatusResp)

    @handler adminBookingComplete
    put /:id/complete (AdminBookingActionReq) returns (StatusResp)

    @handler adminBookingCancel
    put /:id/cancel (AdminBookingActionReq) returns (StatusResp)

    @handler adminBookingTimeoutCancel
    put /:id/timeout-cancel (AdminBookingActionReq) returns (StatusResp)

    @handler adminBookingStatusLog
    get /:id/status-log (StatusLogReq) returns (StatusLogResp)

    @handler adminReviewDetail
    get /:id/review (ReviewDetailReq) returns (BookingReview)

    @handler adminReviewReply
    put /:id/review/reply (ReviewReplyReq) returns (BookingReview)
}

// ============ 法师工作台 - 预约分组 ============
type (
    MasterBookingListReq {
        Status string `form:"status,optional"`
        Page   int    `form:"page,default=1"`
        Size   int    `form:"size,default=20"`
    }

    MasterBookingListResp {
        Total int64     `json:"total"`
        List  []Booking `json:"list"`
        Page  int       `json:"page"`
        Size  int       `json:"size"`
    }
)

@server (
    group: booking.master
    prefix: /api/v1/admin/masters/bookings
    jwt: Auth
)
service booking-service {
    @handler masterBookingList
    get / (MasterBookingListReq) returns (MasterBookingListResp)

    @handler masterBookingDetail
    get /:id (DetailReq) returns (Booking)

    @handler masterBookingConfirm
    put /:id/confirm (AdminBookingActionReq) returns (StatusResp)

    @handler masterBookingStart
    put /:id/start (AdminBookingActionReq) returns (StatusResp)

    @handler masterBookingComplete
    put /:id/complete (AdminBookingActionReq) returns (StatusResp)
}
