syntax = "v1"

info (
    title:   "Auth Service"
    desc:    "问玄东方 认证服务 - 多端登录 / 角色权限 / 管理台账号"
    author:  "askxuan"
    version: "v1"
)

// ============ C端/通用认证 ============
type (
    // LoginReq 邮箱或用户名 + 密码 + 图片验证码；短信尚未开放
    LoginReq {
        Phone    string `json:"phone,optional"`
        Code     string `json:"code,optional"`     // 旧字段，非空时拒绝
        Account  string `json:"account,optional"`  // 已验证邮箱或用户名
        Password string `json:"password,optional"` // 密码
        CaptchaID string `json:"captchaId"`
        CaptchaCode string `json:"captchaCode"`
    }

    // LoginResp 登录响应
    LoginResp {
        AccessToken  string `json:"accessToken"`
        RefreshToken string `json:"refreshToken"`
        ExpiresIn    int64  `json:"expiresIn"` // access token 有效期（秒）
        UserInfo     UserInfo `json:"userInfo"`
        IMToken      string `json:"imToken,optional"` // OpenIM WebSocket 连接 token
    }

    // UserInfo 用户简要信息
    UserInfo {
        UserId   int64  `json:"userId"`
        Nickname string `json:"nickname"`
        Avatar   string `json:"avatar"`
        Mobile   string `json:"mobile"`
    }

    // RefreshReq 续期请求
    RefreshReq {
        RefreshToken string `json:"refreshToken"`
    }

    // RefreshResp 续期响应
    RefreshResp {
        AccessToken string `json:"accessToken"`
        ExpiresIn   int64  `json:"expiresIn"`
    }

    // LogoutReq 登出请求
    LogoutReq {
        AccessToken string `json:"accessToken,optional"`
    }

    // LogoutResp 登出响应
    LogoutResp {
        Success bool `json:"success"`
    }
)

// ============ 管理台登录 ============
type (
    // AdminLoginReq 管理台登录请求（account + password）
    AdminLoginReq {
        Account  string `json:"account"`
        Password string `json:"password"`
        CaptchaID string `json:"captchaId"`
        CaptchaCode string `json:"captchaCode"`
    }
)

// ============ 管理台账号管理 ============
type (
    // AdminAccount 管理台账号
    AdminAccount {
        RoleCode string `json:"roleCode"`
        AuthzScope string `json:"authzScope"`
        AuthzVersion int64 `json:"authzVersion"`
        Id            int64  `json:"id"`
        Account       string `json:"account"`
        Name          string `json:"name"`
        RoleId        int64  `json:"roleId"`
        RoleName      string `json:"roleName,optional"`
        TempleId      string `json:"templeId,optional"`
        MasterId      string `json:"masterId,optional"`
        ShopId        int64  `json:"shopId,optional"`
        Status        string `json:"status"` // enabled/disabled
        LastLoginTime string `json:"lastLoginTime,optional"`
        CreateTime    string `json:"createTime"`
    }

    AdminAccountListReq {
        RoleId int64 `form:"roleId,optional"`
        TempleId string `form:"templeId,optional"`
        MasterId string `form:"masterId,optional"`
        ShopId int64 `form:"shopId,optional"`
        Keyword string `form:"keyword,optional"` // 按账号/姓名模糊搜索
        Status  string `form:"status,optional"`
        Page    int    `form:"page,default=1"`
        Size    int    `form:"size,default=20"`
    }

    AccountIdentity {
        Email string `json:"email"`
        EmailVerified bool `json:"emailVerified"`
        VerifiedAt string `json:"verifiedAt"`
        CredentialState string `json:"credentialState"`
        ActivationStatus string `json:"activationStatus"`
        InvitationEmail string `json:"invitationEmail"`
        CanResetPassword bool `json:"canResetPassword"`
    }
    AccountBinding {
        Type string `json:"type"`
        Id string `json:"id"`
        Name string `json:"name"`
        Status string `json:"status"`
        AuthStatus string `json:"authStatus"`
        ShelfStatus string `json:"shelfStatus"`
        PlatformStatus string `json:"platformStatus"`
    }
    AdminAccountDetailReq {
        Id int64 `path:"id"`
    }
    AdminAccountDetailResp {
        Account AdminAccount `json:"account"`
        Identity AccountIdentity `json:"identity"`
        Bindings []AccountBinding `json:"bindings"`
        LoginAllowed bool `json:"loginAllowed"`
        BlockedReasons []string `json:"blockedReasons"`
    }
    AdminAccountRevokeResp {
        Id int64 `json:"id"`
        Success bool `json:"success"`
    }

    AdminAccountListResp {
        Total int64          `json:"total"`
        List  []AdminAccount `json:"list"`
        Page  int            `json:"page"`
        Size  int            `json:"size"`
    }

    AdminAccountCreateReq {
        Account  string `json:"account"`
        Password string `json:"password"`
        Name     string `json:"name"`
        RoleId   int64  `json:"roleId"`
        TempleId string `json:"templeId,optional"`
        MasterId string `json:"masterId,optional"`
        ShopId   int64  `json:"shopId,optional"`
    }

    AdminAccountCreateResp {
        Id int64 `json:"id"`
    }

    AdminAccountUpdateReq {
        Id       int64  `path:"id"`
        Name     string `json:"name,optional"`
        RoleId   int64  `json:"roleId,optional"`
        TempleId string `json:"templeId,optional"`
        MasterId string `json:"masterId,optional"`
        ShopId   int64  `json:"shopId,optional"`
    }

    AdminAccountStatusReq {
        Id     int64  `path:"id"`
        Status string `json:"status"` // enabled/disabled
    }

    AdminAccountStatusResp {
        Id     int64  `json:"id"`
        Status string `json:"status"`
    }
)

// ============ 角色管理 ============
type (
    Role {
        AuthzScope string `json:"authzScope"`
        AuthzVersion int64 `json:"authzVersion"`
        Editable bool `json:"editable"`
        Id          int64  `json:"id"`
        Name        string `json:"name"`
        Code        string `json:"code"`
        Description string `json:"description"`
        CreateTime  string `json:"createTime"`
    }

    RoleListResp {
        List []Role `json:"list"`
    }

    RoleCreateReq {
        Name        string `json:"name"`
        Code        string `json:"code"`
        Description string `json:"description,optional"`
    }

    RoleCreateResp {
        Id int64 `json:"id"`
    }

    RoleUpdateReq {
        Id          int64  `path:"id"`
        Name        string `json:"name,optional"`
        Description string `json:"description,optional"`
    }
)

// ============ 权限管理 ============
type (
    Permission {
        Assignable bool `json:"assignable"`
        Id       int64  `json:"id"`
        Code     string `json:"code"`
        Name     string `json:"name"`
        Resource string `json:"resource"`
        Action   string `json:"action"`
    }

    PermissionListResp {
        List []Permission `json:"list"`
    }
)

// ============ C端认证分组（保留原有接口） ============
@server (
    group: auth
    prefix: /api/v1/auth
)
service auth-service {
    @handler login
    post /login (LoginReq) returns (LoginResp)

    @handler refresh
    post /refresh (RefreshReq) returns (RefreshResp)

    @handler logout
    post /logout (LogoutReq) returns (LogoutResp)

    @handler adminLogin
    post /admin/login (AdminLoginReq) returns (LoginResp)
    @handler imToken
    post /im-token (IMTokenReq) returns (IMTokenResp)
}

// Additional identity endpoints are implemented in handler/identity.go:
// GET /api/v1/auth/options and /captcha
// POST /api/v1/auth/email/code, /email/register, /password/reset
// Contract and examples: scripts/dev/email-auth/README.md

// ============ 管理台分组（需JWT + 平台超管角色） ============
@server (
    group: auth.admin
    prefix: /api/v1/admin/auth
    jwt: Auth
)
service auth-service {
    @handler adminAccountList
    get /accounts (AdminAccountListReq) returns (AdminAccountListResp)

    @handler adminAccountDetail
    get /accounts/:id (AdminAccountDetailReq) returns (AdminAccountDetailResp)

    @handler adminAccountRevoke
    post /accounts/:id/revoke-sessions (AdminAccountDetailReq) returns (AdminAccountRevokeResp)

    @handler adminAccountCreate
    post /accounts (AdminAccountCreateReq) returns (AdminAccountCreateResp)

    @handler adminAccountUpdate
    put /accounts/:id (AdminAccountUpdateReq) returns (AdminAccount)

    @handler adminAccountStatus
    put /accounts/:id/status (AdminAccountStatusReq) returns (AdminAccountStatusResp)

    @handler adminRoleList
    get /roles returns (RoleListResp)

    @handler adminRoleCreate
    post /roles (RoleCreateReq) returns (RoleCreateResp)

    @handler adminRoleUpdate
    put /roles/:id (RoleUpdateReq) returns (Role)

    @handler adminPermissionList
    get /permissions returns (PermissionListResp)
}

// Live human access snapshot for user/admin domains and custom platform-role grants.
// Fixed roles remain immutable. User access contains no administrative permissions.
type (
    AdminAccessResp {
        UserId int64 `json:"userId"`
        Roles []string `json:"roles"`
        ClientId string `json:"clientId"`
        RoleId int64 `json:"roleId"`
        AccountVersion int64 `json:"accountVersion"`
        RoleVersion int64 `json:"roleVersion"`
        AuthzScope string `json:"authzScope"`
        Permissions []string `json:"permissions"`
    }
    RolePermissionsReq { Id int64 `path:"id"` }
    RolePermissionsUpdateReq {
        Id int64 `path:"id"`
        Revision int64 `json:"revision"`
        PermissionCodes []string `json:"permissionCodes"`
    }
    RolePermissionsResp {
        RoleId int64 `json:"roleId"`
        Revision int64 `json:"revision"`
        PermissionCodes []string `json:"permissionCodes"`
        Editable bool `json:"editable"`
    }
)
@server (
    group: auth.access
    prefix: /api/v1
)
service auth-service {
    @handler adminAccess
    get /auth/access returns (AdminAccessResp)
    @handler rolePermissionsGet
    get /admin/auth/roles/:id/permissions (RolePermissionsReq) returns (RolePermissionsResp)
    @handler rolePermissionsUpdate
    put /admin/auth/roles/:id/permissions (RolePermissionsUpdateReq) returns (RolePermissionsResp)
}
