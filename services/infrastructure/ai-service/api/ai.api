syntax = "v1"

info (
    title:   "AI Service"
    desc:    "问玄东方 AI 问事服务 - 7 技能对话（八字/姻缘/塔罗/风水/奇门/紫微/六爻）"
    author:  "askxuan"
    version: "v1"
)

type (
    AISkill {
        Id             int64  `json:"id"`
        Code           string `json:"code"`
        Category       string `json:"category"`
        Name           string `json:"name"`
        Version        string `json:"version"`
        Description    string `json:"description"`
        Icon           string `json:"icon"`
        SourceType     string `json:"sourceType"`
        SourceRef      string `json:"sourceRef"`
        InputSchema    map[string]interface{} `json:"inputSchema"`
        Capabilities   []string `json:"capabilities"`
        RiskLevel      string `json:"riskLevel"`
        SortOrder      int `json:"sortOrder"`
        Status         string `json:"status"`
        CreatedAt      string `json:"createdAt"`
    }

    SkillListReq {
        Status string `form:"status,optional"`
    }

    SkillListResp {
        List []AISkill `json:"list"`
    }

    AISession {
        Id        int64  `json:"id"`
        SessionNo string `json:"sessionNo"`
        UserId    string `json:"userId"`
        SkillCode string `json:"skillCode"`
        Title     string `json:"title"`
        Status    string `json:"status"` // active/closed
        CreatedAt string `json:"createdAt"`
        UpdatedAt string `json:"updatedAt"`
    }

    SessionCreateReq {
        UserId    string `json:"userId,optional"`
        SkillCode string `json:"skillCode,optional"`
        Question  string `json:"question,optional"`
        Inputs    map[string]interface{} `json:"inputs,optional"`
    }

    SessionCreateResp {
        Id        int64  `json:"id"`
        SessionNo string `json:"sessionNo"`
        SkillCode string `json:"skillCode"`
        Status    string `json:"status"`
        MessageId int64 `json:"messageId"`
    }

    SessionListReq {
        UserId string `form:"userId,optional"`
        Status string `form:"status,optional"`
        Page   int    `form:"page,default=1"`
        Size   int    `form:"size,default=20"`
    }

    SessionListResp {
        Total int64       `json:"total"`
        List  []AISession `json:"list"`
        Page  int         `json:"page"`
        Size  int         `json:"size"`
    }

    SessionDetailReq {
        Id int64 `path:"id"`
        UserId string `form:"userId,optional"`
    }

    AIMessage {
        Id        int64  `json:"id"`
        SessionId int64  `json:"sessionId"`
        Role      string `json:"role"` // user/assistant
        Content   string `json:"content"`
        Inputs map[string]interface{} `json:"inputs,optional"`
        Tokens    int    `json:"tokens"`
        PromptTokens int `json:"promptTokens"`
        CompletionTokens int `json:"completionTokens"`
        Provider string `json:"provider"`
        Model string `json:"model"`
        CostMicros int64 `json:"costMicros"`
        FinishReason string `json:"finishReason"`
        Status    string `json:"status"` // pending/completed/failed
        ErrorMessage string `json:"errorMessage"`
        Retryable bool `json:"retryable"`
        CreatedAt string `json:"createdAt"`
    }

    SessionDetailResp {
        Session  AISession  `json:"session"`
        Messages []AIMessage `json:"messages"`
    }

    MessageListReq {
        Id   int64 `path:"id"`
        UserId string `form:"userId,optional"`
        Page int   `form:"page,default=1"`
        Size int   `form:"size,default=20"`
    }

    MessageListResp {
        Total int64       `json:"total"`
        List  []AIMessage `json:"list"`
        Page  int         `json:"page"`
        Size  int         `json:"size"`
    }

    SessionDeleteReq {
        Id int64 `path:"id"`
        UserId string `form:"userId,optional"`
    }

    IdResp {
        Id int64 `json:"id"`
    }

    MessageSendReq {
        Id      int64  `path:"id"` // 会话 ID
        UserId  string `json:"userId,optional"`
        Content string `json:"content"`
        Inputs map[string]interface{} `json:"inputs,optional"`
    }

    MessageSendResp {
        SessionId int64  `json:"sessionId"`
        MessageId int64 `json:"messageId"`
        Status    string `json:"status"` // accepted
    }

    MessageRetryReq {
        Id int64 `path:"id"`
        MessageId int64 `path:"messageId"`
        UserId string `json:"userId,optional"`
    }

    MessageStreamReq {
        Id int64 `path:"id"`
        MessageId int64 `path:"messageId"`
        UserId string `form:"userId,optional"`
    }

    UsageSummaryReq {
        UserId string `form:"userId,optional"`
    }

    UsageSummaryResp {
        MinuteRequests int `json:"minuteRequests"`
        MinuteLimit int `json:"minuteLimit"`
        DailyRequests int `json:"dailyRequests"`
        DailyLimit int `json:"dailyLimit"`
        DailyTokens int64 `json:"dailyTokens"`
        DailyCostMicros int64 `json:"dailyCostMicros"`
    }
)

@server (
    group: ai
    prefix: /api/v1/ai
)
service ai-service {
    @handler skillList
    get /skills (SkillListReq) returns (SkillListResp)

    @handler sessionCreate
    post /sessions (SessionCreateReq) returns (SessionCreateResp)

    @handler sessionList
    get /sessions (SessionListReq) returns (SessionListResp)

    @handler sessionDetail
    get /sessions/:id (SessionDetailReq) returns (SessionDetailResp)

    @handler messageList
    get /sessions/:id/messages (MessageListReq) returns (MessageListResp)

    @handler messageSend
    post /sessions/:id/messages (MessageSendReq) returns (MessageSendResp)

    @handler messageRetry
    post /sessions/:id/messages/:messageId/retry (MessageRetryReq) returns (MessageSendResp)

    @handler messageStream
    get /sessions/:id/messages/:messageId/stream (MessageStreamReq)

    @handler usageSummary
    get /usage (UsageSummaryReq) returns (UsageSummaryResp)

    @handler sessionDelete
    delete /sessions/:id (SessionDeleteReq) returns (IdResp)
}
