# AI Provider（DeepSeek 使用 OpenAI 兼容接口；正式参数由部署环境注入）
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://模型服务地址/v1
AI_API_KEY=服务端密钥
AI_MODEL=模型或Endpoint名称

# 用户额度与内容边界
AI_MINUTE_REQUEST_LIMIT=12
AI_DAILY_REQUEST_LIMIT=100
AI_MAX_INPUT_CHARS=2000
AI_MAX_HISTORY_MESSAGES=30
AI_MAX_OUTPUT_TOKENS=2048
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
AI_BLOCKED_TERMS=

# MCP 只允许后端受控开启；默认不连接外部工具。
AI_MCP_ENABLED=false
AI_MCP_BASE_URL=
AI_MCP_TIMEOUT_SECONDS=10
